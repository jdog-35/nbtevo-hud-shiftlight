<?xml version="1.0" encoding="utf-8"?>
<plugin>
  <name>ShiftLight</name>
  <type>App</type>
  <file>{pluginDir}/ShiftLight</file>
  <config>
    <autoStart>yes</autoStart>
    <dependencies>
      <pluginAppConnector>
        <type>Etch</type>
        <id>230</id>
        <asyncCallbacks>yes</asyncCallbacks>
      </pluginAppConnector>
    </dependencies>
    <parameters><DescFile>{pluginDir}/ShiftLight.xml</DescFile></parameters>
  </config>
</plugin>
